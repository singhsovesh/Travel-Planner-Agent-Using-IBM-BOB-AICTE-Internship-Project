# IBM watsonx.ai Credentials (IBM Cloud Lite)
IBM_WATSONX_API_KEY=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_PROJECT_ID=

# IBM Granite Model Configuration
IBM_GRANITE_MODEL_ID=ibm/granite-4-h-small

# Open-Meteo Weather API (free, no key required)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# Geocoding API (OpenStreetMap Nominatim - free)
GEOCODING_API_URL=https://nominatim.openstreetmap.org

# Flask Configuration
FLASK_SECRET_KEY=travel_agent_secret_key_change_in_production
FLASK_DEBUG=False
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Application Settings
MAX_ITINERARY_DAYS=14
DEFAULT_CURRENCY=USD
APP_NAME=IBM Travel Planner Agent
